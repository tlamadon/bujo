# Create a Cloudflare Tunnel at https://one.dash.cloudflare.com/
# and paste its token here.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here

# CouchDB credentials (used for PouchDB sync)
COUCHDB_USER=admin
COUCHDB_PASSWORD=changeme

# Optional: accept a Cloudflare Access service token, so the bujo CLI can
# write through the public endpoint. Leave empty to keep this off.
#   CF_ACCESS_TEAM_DOMAIN  your team domain, e.g. myteam.cloudflareaccess.com
#   CF_ACCESS_AUD          the Access application's AUD tag
#   BUJO_SERVICE_TOKENS    <token client id>=<userId to write as>, comma-separated
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
BUJO_SERVICE_TOKENS=
